# ── HTTP 接收層 ──────────────────────────────────────────────
# server 監聽位址。SOC 內部用預設 127.0.0.1。
# 若 Grafana 在別台機器、容器或需從外部把 webhook 打進來，改成 0.0.0.0 或內網 IP。
# （本專案監控 stack：Grafana 跑在 Docker，需經 host.docker.internal 連回 → 設 0.0.0.0）
HOST=127.0.0.1
# 預設 3001（避開 Grafana 自己常用的 3000）
PORT=3001

# Grafana webhook contact point 的 Authorization 憑證（自己產一串夠長的隨機字串）。
# 在 Grafana contact point 設定「Authorization Header」：scheme = Bearer、credentials = 此值。
WEBHOOK_SECRET=change-me-to-a-long-random-string

# webhook request body 大小上限（位元組），防記憶體耗盡。預設 1 MB，通常綽綽有餘。
WEBHOOK_MAX_BODY_BYTES=1048576

# ── Phase 2 可靠度 ──────────────────────────────────────────
# 只播報 >= 此嚴重度的告警；留空 = 不過濾（全播）。
# 可用值：critical > error > warning > info（未知嚴重度視為最低）。resolved 不受此門檻影響。
MIN_SEVERITY=

# 同一 fingerprint 的 firing 在此秒數內只播一次（防洪）。預設 300（5 分鐘）；設 0 關閉防洪。
# resolved 只有在先前播過對應 firing 時才會念「已恢復」。
DEDUP_WINDOW_SEC=300

# ── AIRI sink（LEGACY / dormant，ADR-008 Superseded）──────────
# AIRI 已由瀏覽器 VRM/Live2D avatar 取代（見下方「瀏覽器 avatar 播報」）。
# 以下 AIRI_* 已轉為選填，僅供 dormant airi.ts；用瀏覽器 avatar 時可全留空。
# AIRI 桌面版 server channel 的 WebSocket URL（預設 port 6121、path /ws）。
#
# ⚠️ 你在 WSL、AIRI 桌面版在 Windows 主機 → 不能用 localhost！
#   1) 取 Windows host IP（在 WSL 執行）：  ip route show default | awk '{print $3}'
#      或讀 /etc/resolv.conf 的 nameserver。
#   2) AIRI 設定 > Connection 的 hostname 必須改成 0.0.0.0（預設 127.0.0.1 只聽 Windows loopback，
#      WSL 連不進去）。改完重啟 AIRI。
AIRI_WS_URL=ws://172.x.x.x:6121/ws

# AIRI 設定 > Connection 顯示的 auth token（自動產生的 UUID），複製貼上。
AIRI_AUTH_TOKEN=

# 連上 AIRI 時，這個 client 的識別名稱。
AIRI_NAME=airi-ops-bridge

# 播報語言：zh（繁中）或 en（英文）。現行 sink＝Edge TTS，中文/英文皆支援；
# 預設 zh → zh-TW-HsiaoChenNeural。想以英文播報才設 en。
ALERT_LANG=zh

# ── 瀏覽器 avatar 播報（ADR-001/002/003，現行 sink）──────────
# 前端 avatar 的 WebSocket 廣播埠（Augur/web 連此埠收 BroadcastPlan）。預設 3002。
WS_PORT=3002

# Edge TTS 語音（msedge-tts，免金鑰）。留空 → 依 ALERT_LANG 給預設；可指定其他 Edge 語音。
TTS_VOICE=

# dev/demo：前端「測試播報」鈕經 WS 觸發示範播報。本機 demo 預設 true。
# ⚠️ 生產（WS 曝露於 localhost 之外）務必設 false——否則任何連上者皆可觸發 TTS 合成。
ALLOW_DEV_TRIGGER=true
