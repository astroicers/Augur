{
  "uid": "augur-poc",
  "title": "Augur POC — alertState 探測",
  "tags": [
    "augur",
    "poc",
    "adr-004"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "augur-mascot-panel",
      "title": "Mascot（G-ADR004-1 / alertState 探測）",
      "description": "panel id 必須是 1 —— rules-poc.yml 的 __panelId__ 綁的是這個數字。此 panel 必須至少有一個 query target，否則 alertState 恆為空。",
      "gridPos": {
        "h": 12,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "vector(1)",
          "instant": false,
          "range": true,
          "legendFormat": "poc"
        }
      ],
      "options": {
        "minSeverity": "",
        "repeatFiringMin": 0,
        "fallbackSeverity": "critical",
        "alertLang": "zh",
        "enableTTS": true,
        "ttsVoice": ""
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "對照組：同一個 query 用內建 timeseries 畫",
      "description": "確認資料本身沒問題。若這裡有線而 Mascot panel 沒資料，問題在 plugin 不在 query。",
      "gridPos": {
        "h": 12,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "vector(1)",
          "instant": false,
          "range": true,
          "legendFormat": "poc"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          },
          "min": 0,
          "max": 2
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "augur-mascot-panel",
      "title": "翻轉規則（pending / alerting / normal 三態）",
      "description": "綁 PocFlapping。panel id 必須是 3 以對上 __panelId__。",
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 12
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "minute() % 2",
          "instant": false,
          "range": true,
          "legendFormat": "flap"
        }
      ],
      "options": {
        "minSeverity": "",
        "repeatFiringMin": 0,
        "fallbackSeverity": "critical",
        "alertLang": "zh",
        "enableTTS": true,
        "ttsVoice": ""
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "augur-mascot-panel",
      "title": "Mascot — Windows 效能（rules-perf.yml 3 條）",
      "description": "panel id 必須是 4 —— rules-perf.yml 的 __panelId__ 綁的是這個數字。query 只為滿足「至少一個 target」這個硬前提；alertState 來自規則綁定而非 query 結果。⚠️ 先載入 dashboard 再建規則的話，hasAlertRules latch 不會更新，必須整頁重新載入。",
      "gridPos": {
        "h": 12,
        "w": 12,
