        "enableTTS": true,
        "ttsVoice": ""
      },
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 0.5
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "augur-mascot-panel",
      "title": "Mascot — Windows 安全（rules-security.yml 5 條）",
      "description": "panel id 必須是 5 —— rules-security.yml 的 __panelId__ 綁的是這個數字。這五條需要 Loki（docker compose --profile security）與 Windows 端的 Alloy；沒起的話規則停在 No Data 並以 OK 處理，不會誤報。",
      "gridPos": {
        "h": 12,
        "w": 12,
        "x": 12,
        "y": 22
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
